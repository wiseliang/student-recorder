{
  "expo": {
    "name": "学工录入助手",
    "slug": "student-recorder",
    "version": "1.12.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1B62A5"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.wiseliang.studentrecorder",
      "adaptiveIcon": {
        "backgroundColor": "#1B62A5"
      },
      "versionCode": 20
    },
    "extra": {
      "eas": {
        "projectId": "fc2861bf-68ea-4924-ae81-e971782a7153"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "选择本人有权查询的照片",
          "cameraPermission": "拍摄待人工核对的人员照片",
          "microphonePermission": false
        }
      ]
    ]
  }
}
